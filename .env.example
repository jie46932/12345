VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_TELEMETRY_ENABLED=0
VITE_MEDIA_BASE_URL=

ADMIN_USER=
ADMIN_PASS=
ACCESS_TOKEN=

# OSS 上传脚本使用。不要把 AccessKey 写入仓库；请先在本机或服务器执行 aliyun configure。
OSS_BUCKET=
OSS_PREFIX=12345
OSS_CLI=aliyun

# 静态 dist 同步到阿里云等 Linux 服务器时使用。
# 不要把真实服务器密钥或密码写入仓库；优先使用本机 SSH key。
DEPLOY_HOST=
DEPLOY_USER=
DEPLOY_PORT=22
DEPLOY_PATH=/srv/www/projects/12345/current
DEPLOY_IDENTITY=
